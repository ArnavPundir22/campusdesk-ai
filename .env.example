# CampusDesk AI Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI Model Configuration
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here_optional
DEFAULT_AI_PROVIDER=gemini  # gemini or openai

# Notion Integration
NOTION_API_KEY=secret_your_notion_integration_token_here
NOTION_REQUESTS_DB_ID=your_requests_database_id_here
NOTION_RUN_LOG_DB_ID=your_run_log_database_id_here
MOCK_NOTION=true  # Set to false when live Notion DB is connected

# Email Dispatch
RESEND_API_KEY=re_your_resend_api_key_here
SENDER_EMAIL=campusdesk@university.edu.in
MOCK_EMAIL=true   # Set to false when live SMTP/Resend credentials are provided

# Business Logic Thresholds
AUTO_APPROVE_BUDGET_MAX_INR=1000.0
AUTO_APPROVE_LEAVE_MAX_DAYS=1
